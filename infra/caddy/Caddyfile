{
  email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
  encode gzip zstd

  handle /api {
    reverse_proxy api:3001
  }

  handle_path /api/* {
    reverse_proxy api:3001
  }

  handle /admin {
    reverse_proxy admin-web:3000
  }

  handle /admin/* {
    reverse_proxy admin-web:3000
  }

  handle {
    reverse_proxy web:3000
  }
}
